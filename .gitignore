# ==============================================================================
# Git Ignore Configuration for SIH 2026 Project
# Multi-Camera ANPR Trajectory Tracking & Urban Traffic Analytics
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Node & Frontend (React / Vite)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# 4. Databases & Persistent State
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.sqlite3
!backend/data/.gitkeep

# ------------------------------------------------------------------------------
# 5. AI / CV Models, Heavy Weights & Checkpoints
# ------------------------------------------------------------------------------
*.pt
*.pth
*.onnx
*.weights
*.bin
*.h5
*.tflite
*.safetensors
models/weights/
ai_cv/weights/

# ------------------------------------------------------------------------------
# 6. Generated Test Frames, Media & Output Artifacts
# ------------------------------------------------------------------------------
data/anpr_output/*
!data/anpr_output/.gitkeep
# Generated video processing outputs & raw video uploads
*.mp4
*.avi
*.mov
*.mkv

# ------------------------------------------------------------------------------
# 7. Environment Variables, Local Configs & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.local
frontend/.env.local
frontend/.env.*.local

# ------------------------------------------------------------------------------
# 8. Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp

# ------------------------------------------------------------------------------
# 9. IDE, Editors & OS Files
# ------------------------------------------------------------------------------
# Operating System
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / PyCharm / WebStorm
.idea/

# Jupyter Notebooks
.ipynb_checkpoints/
